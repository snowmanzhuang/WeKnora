# Local source-built deployment for snowmanzhuang/WeKnora commit 72ca1256.
WEKNORA_VERSION=custom-8a54bd9b
WEKNORA_LLM_STREAM_RAW_DUMP=1
APK_MIRROR_ARG=https://mirrors.tencent.com
APT_MIRROR=https://mirrors.tencent.com

GIN_MODE=release
TZ=Asia/Shanghai
AUTO_MIGRATE=true
AUTO_RECOVER_DIRTY=true

APP_HOST=app
APP_PORT=8080
FRONTEND_PORT=80
DOCREADER_ADDR=docreader:50051
DOCREADER_TRANSPORT=grpc

DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123!@#
DB_NAME=WeKnora

STREAM_MANAGER_TYPE=redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=redis123!@#
REDIS_DB=0
REDIS_PREFIX=stream:

RETRIEVE_DRIVER=postgres
STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=/data/files
MAX_FILE_SIZE_MB=800
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_OPTIONAL=true

# Trusted model endpoints allowed through WeKnora's SSRF protection.
# host.docker.internal points from the Docker container to this Windows host.
SSRF_WHITELIST_EXTRA=searxng,qdrant,milvus,weaviate,doris-fe,host.docker.internal,openrouter.ai,api.deepseek.com

# Doubled worker and model concurrency for the large book-ingestion batch.
WEKNORA_ASYNQ_CORE_CONCURRENCY=16
WEKNORA_ASYNQ_POSTPROCESS_CONCURRENCY=4
WEKNORA_ASYNQ_ENRICHMENT_CONCURRENCY=8
WEKNORA_ASYNQ_MAINTENANCE_CONCURRENCY=8
WEKNORA_ASYNQ_SHARED_CONCURRENCY=4
WEKNORA_WIKI_ASYNQ_CONCURRENCY=16
WEKNORA_MODEL_MAX_CONCURRENCY=64

# Keep the historical defaults so the retained July 14 data volume remains decryptable.
JWT_SECRET=weknora-jwt-secret
SYSTEM_AES_KEY=weknora-system-aes-key-32bytes!!
